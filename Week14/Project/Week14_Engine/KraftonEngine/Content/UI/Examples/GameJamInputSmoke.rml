<rml>
<head>
<style>
body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: sans-serif;
    color: #f7fbff;
}

#panel {
    position: absolute;
    left: 32px;
    top: 32px;
    width: 420px;
    padding: 18px;
    background-color: rgba(16, 24, 36, 0.92);
    border-width: 1px;
    border-color: rgba(118, 180, 255, 0.8);
    border-radius: 8px;
}

#title {
    font-size: 22px;
    margin-bottom: 8px;
    color: #8fd3ff;
}

#status {
    margin-top: 8px;
    margin-bottom: 12px;
    font-size: 15px;
    color: #d7e7f7;
}

#input {
    width: 380px;
    height: 28px;
    padding: 4px 8px;
    margin-bottom: 12px;
    background-color: #f7fbff;
    color: #122033;
    border-radius: 4px;
}

button {
    width: 120px;
    height: 32px;
    margin-right: 8px;
    background-color: #2b7fff;
    color: #ffffff;
    border-radius: 4px;
}

button:hover {
    background-color: #52a5ff;
}

.pulse {
    background-color: rgba(44, 160, 104, 0.95);
}
</style>
</head>
<body>
    <div id="panel">
        <div id="title">Input/UI Smoke</div>
        <div id="status">Click or type here. Game input should not leak while UI consumes.</div>
        <input id="input" value="" />
        <button id="pulse" data-action="pulse">Pulse</button>
        <button id="close" data-action="close">Close</button>
    </div>
</body>
</rml>
