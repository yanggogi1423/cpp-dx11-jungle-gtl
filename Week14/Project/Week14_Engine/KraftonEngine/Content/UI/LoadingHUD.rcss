    height: 390.000000px;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(3, 12, 13, 132);
    border-width: 0px;
    padding: 0px;
    font-family: "Nexon";
}

#loadingControlsTitle {
    position: absolute;
