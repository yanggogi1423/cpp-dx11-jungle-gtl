body {
    margin: 0px;
    width: 1920.000000px;
    height: 1080.000000px;
}

#loadingRoot {
    position: relative;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 255);
    color: rgba(238, 243, 246, 255);
    border-width: 0px;
    padding: 0px;
    font-family: "Nexon";
    font-size: 24.000000px;
    text-align: left;
}

#loadingSnapshotSlot {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
}

#loadingSnapshotImage {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
}

#loadingBottomFade {
    position: absolute;
    left: 0px;
    bottom: 0px;
    width: 100.000000%;
    height: 432.000000px;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
}

#loadingBottomGradient {
