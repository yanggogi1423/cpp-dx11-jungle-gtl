body {
    margin: 0px;
    width: 1920.000000px;
    height: 1080.000000px;
}

#preInGameRoot {
    position: relative;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 255);
    color: rgba(238, 243, 246, 255);
    border-width: 0px;
    padding: 0px;
    font-family: "Nexon";
    font-size: 24.000000px;
    text-align: left;
}

.story-sheet {
    position: absolute;
    left: 600.000000px;
    top: -420.000000px;
    width: 720.000000px;
    height: 540.000000px;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
    transform: scale(2.325);
    transform-origin: center center;
}

#approvedStamp {
    position: absolute;
    left: 540.000000px;
    top: 453.000000px;
    width: 840.000000px;
    height: 174.000000px;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
    transform: rotate(-4deg) scale(1.08);
    transform-origin: center center;
}

#skipPrompt {
    position: absolute;
    right: 32.000000px;
    bottom: 28.000000px;
    width: 220.000000px;
    height: 28.000000px;
    box-sizing: border-box;
    opacity: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    padding: 0px;
    color: rgba(255, 213, 118, 255);
    font-family: "Nexon";
    font-size: 18.000000px;
    text-align: right;
}

#newsSubtitle {
    position: absolute;
    left: 60.000000px;
    bottom: 36.000000px;
    width: 1800.000000px;
    height: 58.000000px;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    background-color: rgba(0, 0, 0, 168);
    border-width: 1.000000px;
    border-color: rgba(255, 255, 255, 52);
    padding: 10.000000px 30.000000px 10.000000px 30.000000px;
    color: rgba(255, 255, 255, 255);
    font-family: "Nexon";
    font-weight: 700;
    font-size: 24.000000px;
    line-height: 34.000000px;
    text-align: center;
    white-space: nowrap;
}
