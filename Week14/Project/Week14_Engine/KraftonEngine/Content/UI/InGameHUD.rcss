body {
    margin: 0px;
    width: 1920.000000px;
    height: 1080.000000px;
}

#hudRoot {
    position: relative;
    left: 0px;
    top: 0px;
    width: 100.000000%;
    height: 100.000000%;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 255);
    border-color: rgba(255, 255, 255, 0);
    border-width: 0px 0px 0px 0px;
    border-radius: 0px;
    padding: 0px 0px 0px 0px;
    font-size: 24.000000px;
    text-align: center;
}

#compassImage {
    position: absolute;
    left: 560.000000px;
    top: 2.000000px;
